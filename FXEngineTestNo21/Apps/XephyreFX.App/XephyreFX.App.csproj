<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>XephyreFX.App</RootNamespace>
    <AssemblyName>XephyreFX</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- Only kicks in when a runtime identifier is given (i.e. actually publishing, like
       "dotnet publish -r win-x64"). Plain "dotnet run"/"dotnet build" with no -r is
       untouched by this and keeps working exactly as before, since self-contained requires
       a RID, so applying this unconditionally would break the no-RID case. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.1.3" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Events\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="YOUTUBE_LINK.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
